# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin API auth (Next /api/admin/* and Edge Function admin_delete_specialist via x-admin-token)
ADMIN_API_TOKEN=your_long_random_admin_token

# Partner Program referral cookie HMAC (server-only). Falls back to derived ADMIN_API_TOKEN if unset.
# PARTNER_REF_SECRET=your_long_random_partner_ref_secret
# Live partner payouts via Stripe Connect (keep false until Freuly Stripe + bank account are ready)
PARTNER_PAYOUTS_ENABLED=false
# Optional override for Partner Agreement version stored on accept
# PARTNER_AGREEMENT_VERSION=2026-07-v1
# STRIPE_CONNECT_CLIENT_ID=
# Edge Function secrets (Supabase Dashboard or CLI): ADMIN_API_TOKEN, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ENABLE_SPECIALIST_HARD_DELETE=true

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional URLs from hosting provider
# VERCEL_URL=your-project.vercel.app
# NEXT_PUBLIC_APP_URL=https://freuly.de

# Dev gate key for middleware (?dev=...)
# DEV_ACCESS_KEY=your_dev_access_key

# Application settings
TERMS_VERSION=1.0
CATEGORY_MIN_SPECIALISTS=1
# NEXT_PUBLIC_CATEGORY_MIN_COUNT=1

# Billing / subscriptions (future — payments disabled by default; no checkout until explicitly enabled)
# PAYMENTS_ENABLED: online payments off by default
# SUBSCRIPTION_ENFORCEMENT_ENABLED: automatic subscription enforcement off by default
# SUBSCRIPTION_PUBLIC_PAID_COPY_ENABLED: stronger public paid-tier copy off by default
# MANUAL_INVOICES_ENABLED: invoice / bank transfer request flow off by default
PAYMENTS_ENABLED=false
SUBSCRIPTION_ENFORCEMENT_ENABLED=false
SUBSCRIPTION_PUBLIC_PAID_COPY_ENABLED=false
MANUAL_INVOICES_ENABLED=false

# Stripe (future — only when PAYMENTS_ENABLED=true and legal go-live)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BASIC=
# STRIPE_PRICE_PREMIUM=

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=Freuly <no-reply@freuly.de>

# Optional admin IP allowlist (comma separated)
# NEXT_PUBLIC_ADMIN_IP_WHITELIST=127.0.0.1,::1

# Telegram (webhook: set secret in BotFather / webhook config; must match X-Telegram-Bot-Api-Secret-Token)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# Upstash Redis REST (rate limiting for public write APIs; if unset, limits are disabled — fail open)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
