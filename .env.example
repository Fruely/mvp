# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database (для будущей интеграции)
DATABASE_URL=your_database_url_here

# Site URL (no trailing slash). For specialist auth redirect. In Supabase add to Redirect URLs:
#   ${NEXT_PUBLIC_SITE_URL}/specialist/dashboard, ${NEXT_PUBLIC_SITE_URL}/specialist/claim
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_key_here

# Payment Gateway (для будущей интеграции)
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# Email Service (для будущей интеграции)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@froyle.com
