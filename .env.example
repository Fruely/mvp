# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin API auth (Next /api/admin/* and Edge Function admin_delete_specialist via x-admin-token)
ADMIN_API_TOKEN=your_long_random_admin_token

# Partner Program referral cookie HMAC (server-only). Falls back to derived ADMIN_API_TOKEN if unset.
# PARTNER_REF_SECRET=your_long_random_partner_ref_secret
# Live partner payouts via Stripe Connect (keep false until Freuly Stripe + bank account are ready)
PARTNER_PAYOUTS_ENABLED=false
# Optional override for Partner Agreement version stored on accept (default: 1.4)
# PARTNER_AGREEMENT_VERSION=1.4
# STRIPE_CONNECT_CLIENT_ID=
# Edge Function secrets (Supabase Dashboard or CLI): ADMIN_API_TOKEN, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ENABLE_SPECIALIST_HARD_DELETE=true

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional URLs from hosting provider
# VERCEL_URL=your-project.vercel.app
# NEXT_PUBLIC_APP_URL=https://freuly.de

# Dev gate key for middleware (?dev=...)
# DEV_ACCESS_KEY=your_dev_access_key

# Application settings
TERMS_VERSION=1.3
SPECIALIST_RULES_VERSION=2.2
CATEGORY_MIN_SPECIALISTS=1
# NEXT_PUBLIC_CATEGORY_MIN_COUNT=1

# Billing / commercial access.
# Keep example defaults off: production enables payment features explicitly in hosting env.
# PAYMENTS_ENABLED controls tariff checkout.
# LEAD_ENGINE_DIRECT_PPL_CHECKOUT_ENABLED controls one-off checkout for direct client requests.
# SUBSCRIPTION_ENFORCEMENT_ENABLED controls tariff lifecycle enforcement only; it must not
# be used to hide an otherwise eligible free base profile.
# SUBSCRIPTION_PUBLIC_PAID_COPY_ENABLED is legacy/compatibility and must not restore
# "pay to publish" positioning.
# MANUAL_INVOICES_ENABLED controls the optional invoice / bank transfer flow.
PAYMENTS_ENABLED=false
LEAD_ENGINE_DIRECT_PPL_CHECKOUT_ENABLED=false
SUBSCRIPTION_ENFORCEMENT_ENABLED=false
SUBSCRIPTION_PUBLIC_PAID_COPY_ENABLED=false
MANUAL_INVOICES_ENABLED=false

# Stripe (only when PAYMENTS_ENABLED=true and legal go-live)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BASIC=
# STRIPE_PRICE_PREMIUM=
# STRIPE_PRICE_BASIC_MONTHLY=
# STRIPE_PRICE_PREMIUM_MONTHLY=
# STRIPE_PRICE_BASIC_ANNUAL=
# STRIPE_PRICE_PREMIUM_ANNUAL=

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=Freuly <no-reply@freuly.de>

# Optional admin IP allowlist (comma separated)
# NEXT_PUBLIC_ADMIN_IP_WHITELIST=127.0.0.1,::1

# Telegram (webhook: set secret in BotFather / webhook config; must match X-Telegram-Bot-Api-Secret-Token)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=@your_public_channel_username
# OPENAI_API_KEY=sk-proj-your-openai-api-key
# TELEGRAM_POST_AI_MODEL=gpt-5.6-luna
# TELEGRAM_WEBHOOK_SECRET=

# Upstash Redis REST (rate limiting for public write APIs; if unset, limits are disabled — fail open)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
