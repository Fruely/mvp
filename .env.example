# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin API auth
ADMIN_API_TOKEN=your_long_random_admin_token

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional URLs from hosting provider
# VERCEL_URL=your-project.vercel.app
# NEXT_PUBLIC_APP_URL=https://freuly.de

# Dev gate key for middleware (?dev=...)
# DEV_ACCESS_KEY=your_dev_access_key

# Application settings
TERMS_VERSION=1.0
CATEGORY_MIN_SPECIALISTS=1
# NEXT_PUBLIC_CATEGORY_MIN_COUNT=1

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=Freuly <no-reply@freuly.de>

# Optional admin IP allowlist (comma separated)
# NEXT_PUBLIC_ADMIN_IP_WHITELIST=127.0.0.1,::1
